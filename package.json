{
  "name": "local-roots",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:release-receipt": "node --test tests/release-receipt.test.mjs tests/guarded-provider-release.test.mjs",
    "release:admit": "node scripts/validate-release-receipt.mjs",
    "release:hbnf-glow-admit": "node scripts/hbnf-two-target-admission.mjs",
    "release:verify": "node scripts/validate-release-receipt.mjs",
    "release:audit-workflows": "node scripts/audit-release-workflows.mjs",
    "test:m2": "rm -rf dist && tsc && mkdir -p dist/tests/fixtures && cp tests/fixtures/events.json dist/tests/fixtures/events.json && node --test dist/tests/*.test.js",
    "test": "npm run typecheck && npm run test:m2 && npm run test:release-receipt && npm run test:udisc-glow",
    "test:udisc-glow": "HBNF_GLOW_HTML=source-snapshots/hbnf-worker-d1a5f936-20261024/public/glow.html node --test --test-concurrency=1 tests/udisc-glow-*.test.mjs && python3 source-snapshots/hbnf-worker-d1a5f936-20261024/tests/verify-worker-package-closure.py",
    "release:execute": "node scripts/guarded-provider-release.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
