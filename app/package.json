{
  "name": "local-roots-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:du-handoff && npm run test:studio && npm run test:weather && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "check:du-handoff": "node scripts/check-du-handoff.mjs",
    "test:studio": "node --test tests/dye-studio.integration.test.mjs tests/dye-studio.model.test.mjs tests/dye-studio.evidence.test.mjs",
    "test:weather": "node --test tests/weather*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "jszip": "^3.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
