{
  "schema": "hbnf-control-model-v2",
  "authority": "PRIMARY_OPERATIONAL_DECISION_MODEL",
  "design": "linear_stage_receipts",
  "principles": [
    "One current lifecycle state.",
    "Exactly one declared next transition from every nonterminal state.",
    "Each transition consumes exactly one self-contained stage receipt.",
    "Receipts contain direct check results only; receipts may not depend on or cite other receipts, policy documents, runbooks, or postmortems.",
    "No recursive evaluation, rule chaining, document precedence, or cross-stage boolean graph.",
    "Unknown or missing checks fail closed.",
    "Human approvals are explicit fields on the transition receipt.",
    "Exact source identity may be a Git commit or a content-addressed source tree/archive; Git metadata is not mandatory if stronger content identity is proven."
  ],
  "states": [
    "DIAGNOSTIC_ACTIVE",
    "FIX_CANDIDATE",
    "FOUNDATION_QUALIFIED",
    "PHASE2_INTEGRATING",
    "RELEASE_CANDIDATE",
    "ACCEPTED"
  ],
  "transitions": [
    {
      "id": "T1_DIAGNOSTIC_CLOSE",
      "from": "DIAGNOSTIC_ACTIVE",
      "to": "FIX_CANDIDATE",
      "receipt_type": "diagnostic_close",
      "required_checks": [
        "diagnostic_artifact_identity",
        "timing_attribution_complete",
        "root_cause_proven",
        "bounded_fix_delta",
        "candidate_artifact_identity",
        "nonhardware_tests_passed"
      ],
      "human_approval_required": false
    },
    {
      "id": "T2_FOUNDATION_QUALIFY",
      "from": "FIX_CANDIDATE",
      "to": "FOUNDATION_QUALIFIED",
      "receipt_type": "foundation_qualification",
      "required_checks": [
        "install_health_passed",
        "runtime_telemetry_verified",
        "runtime_smoke_passed",
        "instrumentation_observer_effect_passed",
        "common_path_performance_audit_passed",
        "all_kernel_sweep_passed",
        "foundation_soak_passed",
        "feature_acceptance_passed",
        "clean_room_rebuild_passed",
        "golden_capsule_complete",
        "rollback_verified",
        "flight_recorder_ready"
      ],
      "human_approval_required": true
    },
    {
      "id": "T3_PHASE2_START",
      "from": "FOUNDATION_QUALIFIED",
      "to": "PHASE2_INTEGRATING",
      "receipt_type": "phase2_scope_lock",
      "required_checks": [
        "scope_contract_locked",
        "interfaces_frozen",
        "lane_plan_ready",
        "acceptance_matrix_locked"
      ],
      "human_approval_required": true
    },
    {
      "id": "T4_PHASE2_INTEGRATION",
      "from": "PHASE2_INTEGRATING",
      "to": "RELEASE_CANDIDATE",
      "receipt_type": "phase2_integration",
      "required_checks": [
        "committed_features_implemented",
        "integration_runtime_smokes_passed",
        "no_unapproved_scope_change",
        "guest_platform_integrated",
        "package_complete",
        "signed_release_preflight_passed"
      ],
      "human_approval_required": false
    },
    {
      "id": "T5_RELEASE_ACCEPT",
      "from": "RELEASE_CANDIDATE",
      "to": "ACCEPTED",
      "receipt_type": "release_acceptance",
      "required_checks": [
        "final_soak_passed",
        "physical_acceptance_passed",
        "guest_shareability_passed",
        "update_recovery_passed",
        "final_capsule_complete"
      ],
      "human_approval_required": true
    }
  ],
  "receipt_contract": {
    "schema": "hbnf-stage-receipt-v1",
    "required_top_level": [
      "schema",
      "receipt_type",
      "transition_id",
      "subject",
      "checks",
      "outcome",
      "evidence_artifacts"
    ],
    "subject_required": [
      "release_id",
      "source_identity_type",
      "source_identity",
      "artifact_sha256"
    ],
    "outcome_required": "PASS",
    "forbidden_evidence_name_patterns": [
      "receipt",
      "control_model",
      "control_state",
      "read_first",
      "postmortem",
      "runbook",
      "aks"
    ],
    "source_identity_types": [
      "git_commit",
      "source_tree_sha256",
      "source_archive_sha256"
    ]
  },
  "execution_system": {
    "schema": "hbnf-execution-system-v1",
    "purpose": "Make the existing lifecycle model execute linearly with evidence reuse, selective invalidation, failure isolation, and safe parallelism; this is part of the primary control model, not a new authority layer.",
    "operating_loop": [
      "CURRENT_NODE",
      "INHERIT_VALID_EVIDENCE",
      "CLASSIFY_CHANGE_AND_REQUIRED_CHECKS",
      "EXECUTE_READY_WORK",
      "CLASSIFY_FAILURE_OR_PASS",
      "INVALIDATE_ONLY_AFFECTED_EVIDENCE",
      "ADVANCE_NODE"
    ],
    "evidence_inheritance": {
      "rule": "A passed check remains valid for the exact subject it proves until an explicit invalidator changes.",
      "exact_subject_fields": [
        "release_id",
        "artifact_sha256",
        "source_identity_type",
        "source_identity"
      ],
      "unknown_impact": "Conservatively broaden verification only when impact cannot be established; do not automatically reopen unrelated closed gates.",
      "host_failure_rule": "A host/test-harness failure does not invalidate firmware/runtime evidence unless device identity, restart continuity, renderer restore, AUX health, or another actual device gate is unknown or failed.",
      "no_repeat_rule": "Do not rerun a passed check merely because a new transaction, chat, sequence number, or worker begins."
    },
    "failure_domains": {
      "HOST_HARNESS": {
        "invalidates": [
          "host_harness_result_only"
        ],
        "default_action": "repair/replay host path against fixtures; preserve device installation when exact identity/health/restore evidence remains valid"
      },
      "DEVICE_RUNTIME": {
        "invalidates": [
          "runtime_telemetry_verified",
          "runtime_smoke_passed",
          "common_path_performance_audit_passed",
          "all_kernel_sweep_passed",
          "foundation_soak_passed",
          "feature_acceptance_passed"
        ],
        "default_action": "localize device/runtime defect; recover only when required by health/safety"
      },
      "RELEASE_DEPLOYMENT": {
        "invalidates": [
          "install_health_passed",
          "signed_release_preflight_passed",
          "update_recovery_passed"
        ],
        "default_action": "repair release/deployment mechanism without reopening unrelated product/runtime evidence"
      },
      "UI_BACKEND": {
        "invalidates": [
          "integration_runtime_smokes_passed",
          "committed_features_implemented"
        ],
        "default_action": "repair affected UI/backend lane only"
      },
      "PHYSICAL_HARDWARE": {
        "invalidates": [
          "physical_acceptance_passed"
        ],
        "default_action": "repair/retest affected physical subsystem and its direct integration only"
      },
      "AESTHETIC_PRODUCT": {
        "invalidates": [
          "affected_feature_human_acceptance_only"
        ],
        "default_action": "iterate affected feature without reopening unrelated technical gates"
      }
    },
    "change_impact": {
      "HOST_HARNESS_ONLY": {
        "invalidates": [],
        "required_verification": [
          "host regression fixtures",
          "affected orchestration path"
        ],
        "foundation_requalification": false
      },
      "MATRIX_RENDERER_OR_SCHEDULER": {
        "invalidates": [
          "runtime_telemetry_verified",
          "runtime_smoke_passed",
          "common_path_performance_audit_passed",
          "all_kernel_sweep_passed",
          "foundation_soak_passed",
          "feature_acceptance_passed"
        ],
        "foundation_requalification": true
      },
      "MATRIX_INSTRUMENTATION": {
        "invalidates": [
          "runtime_telemetry_verified",
          "instrumentation_observer_effect_passed",
          "all_kernel_sweep_passed",
          "foundation_soak_passed"
        ],
        "foundation_requalification": true
      },
      "AUDIO_FEATURES_OR_REALTIME_RENDER_MAPPING": {
        "invalidates": [
          "runtime_smoke_passed",
          "feature_acceptance_passed",
          "integration_runtime_smokes_passed"
        ],
        "foundation_requalification": "ONLY_IF_REALTIME_RUNTIME_OR_FRAME_BUDGET_ASSUMPTIONS_CHANGE"
      },
      "VIBE_DATA_OR_TUNING_ONLY": {
        "invalidates": [
          "committed_features_implemented",
          "integration_runtime_smokes_passed"
        ],
        "foundation_requalification": false
      },
      "MISSION_CONTROL_OR_PWA": {
        "invalidates": [
          "committed_features_implemented",
          "integration_runtime_smokes_passed",
          "physical_acceptance_passed"
        ],
        "foundation_requalification": false
      },
      "SCORING_BACKEND_OR_CONTRACT": {
        "invalidates": [
          "committed_features_implemented",
          "integration_runtime_smokes_passed",
          "physical_acceptance_passed"
        ],
        "foundation_requalification": false
      },
      "TEXT_OR_VISUAL_MOMENT": {
        "invalidates": [
          "committed_features_implemented",
          "integration_runtime_smokes_passed"
        ],
        "foundation_requalification": "ONLY_IF_RENDERER_RUNTIME_ASSUMPTIONS_CHANGE"
      },
      "AUX_FIRMWARE_OR_DDP": {
        "invalidates": [
          "feature_acceptance_passed",
          "integration_runtime_smokes_passed",
          "physical_acceptance_passed"
        ],
        "foundation_requalification": "ONLY_IF_FOUNDATION_AUX_CONTINUITY_OR_LOAD_ASSUMPTIONS_CHANGE"
      },
      "PHYSICAL_AUX_UV": {
        "invalidates": [
          "physical_acceptance_passed"
        ],
        "foundation_requalification": false
      },
      "UNKNOWN": {
        "invalidates": "CURRENT_AND_DOWNSTREAM_UNCLOSED_GATES_AS_NEEDED",
        "foundation_requalification": "DETERMINE_FROM_ACTUAL_DEPENDENCY_IMPACT_BEFORE_MUTATION"
      }
    },
    "parallelism": {
      "rule": "Exactly one live-device mutation lane at a time. Any number of dependency-satisfied host/offline/staging lanes may run in parallel when they cannot alter the live candidate or its evidence.",
      "live_lane_limit": 1,
      "prohibit_duplicate_investigation": true
    },
    "phase2_dag": [
      {
        "node": "P2_INTERFACE_FREEZE",
        "depends_on": [
          "T2_FOUNDATION_QUALIFY"
        ],
        "outputs": [
          "AudioFeatures",
          "VibeSelection",
          "VisualMoment",
          "HealthState",
          "scoring/control boundary"
        ]
      },
      {
        "node": "P2_MISSION_CONTROL_SCORING",
        "depends_on": [
          "P2_INTERFACE_FREEZE"
        ],
        "parallel_group": "CORE"
      },
      {
        "node": "P2_VIBE_AUDIO",
        "depends_on": [
          "P2_INTERFACE_FREEZE"
        ],
        "parallel_group": "CORE"
      },
      {
        "node": "P2_TEXT_MOMENTS",
        "depends_on": [
          "P2_INTERFACE_FREEZE"
        ],
        "parallel_group": "CORE"
      },
      {
        "node": "P2_PWA_RELIABILITY",
        "depends_on": [
          "P2_INTERFACE_FREEZE"
        ],
        "parallel_group": "CORE"
      },
      {
        "node": "P2_INTEGRATED_CANDIDATE",
        "depends_on": [
          "P2_MISSION_CONTROL_SCORING",
          "P2_VIBE_AUDIO",
          "P2_TEXT_MOMENTS",
          "P2_PWA_RELIABILITY"
        ]
      },
      {
        "node": "T4_PHASE2_INTEGRATION",
        "depends_on": [
          "P2_INTEGRATED_CANDIDATE"
        ]
      },
      {
        "node": "T5_RELEASE_ACCEPT",
        "depends_on": [
          "T4_PHASE2_INTEGRATION"
        ]
      },
      {
        "node": "POST_ACCEPT_EXPANSION",
        "depends_on": [
          "T5_RELEASE_ACCEPT"
        ],
        "parallel_children": [
          "AUX_UV",
          "ARCADE",
          "IRL_GAMES",
          "GUEST_PLATFORM"
        ]
      }
    ],
    "priority_rule": "Critical-path work first; use unavoidable wait/soak time for ready parallel work; never create event-only throwaway architecture when the same work can advance final Cart 2.0.",
    "parallelism_enforcement": {
      "schema": "hbnf-parallelism-enforcement-v1",
      "purpose": "Prevent safe ready lanes from being silently serialized or abandoned.",
      "core_lanes": [
        "P2_MISSION_CONTROL_SCORING",
        "P2_VIBE_AUDIO",
        "P2_TEXT_MOMENTS",
        "P2_PWA_RELIABILITY"
      ],
      "activation": {
        "foundation_soak": "As soon as the >=90-minute Foundation soak is cleanly running, start all core lanes that can proceed without mutating the live candidate. Each lane must be ACTIVE, DONE, or BLOCKED_WITH_EXACT_DEPENDENCY; silent IDLE/QUEUED is not acceptable.",
        "phase2": "At PHASE2_INTEGRATING, all four core lanes are mandatory concurrent workstreams until DONE or BLOCKED_WITH_EXACT_DEPENDENCY."
      },
      "state_contract": {
        "field": "lane_execution",
        "required_when": [
          "PHASE2_INTEGRATING",
          "RELEASE_CANDIDATE"
        ],
        "lane_status_values": [
          "ACTIVE",
          "DONE",
          "BLOCKED_WITH_EXACT_DEPENDENCY"
        ],
        "blocked_requires": [
          "blocker",
          "dependency"
        ],
        "idle_ready_lane_is_violation": true
      },
      "sequencing": [
        "One live-device mutation lane maximum.",
        "Offline/staging lanes do not wait on unrelated live work once their dependencies are satisfied.",
        "A worker may combine lanes internally only if the state still records each lane independently and no lane becomes silently idle.",
        "Integration waits for lane outputs; lanes do not wait for integration."
      ],
      "anti_abandonment": "A previously declared parallel lane may be removed, serialized, or deferred only when its dependency is explicitly blocked or the user changes scope. Convenience, chat turnover, worker turnover, or a new transaction is not sufficient."
    }
  }
}
