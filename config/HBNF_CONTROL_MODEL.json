{
  "schema": "hbnf-control-model-v2",
  "authority": "PRIMARY_OPERATIONAL_DECISION_MODEL",
  "design": "linear_stage_receipts",
  "principles": [
    "One current lifecycle state.",
    "Exactly one declared next transition from every nonterminal state.",
    "Each transition consumes exactly one self-contained stage receipt.",
    "Receipts contain direct check results only; receipts may not depend on or cite other receipts, policy documents, runbooks, or postmortems.",
    "No recursive evaluation, rule chaining, document precedence, or cross-stage boolean graph.",
    "Unknown or missing checks fail closed.",
    "Human approvals are explicit fields on the transition receipt.",
    "Exact source identity may be a Git commit or a content-addressed source tree/archive; Git metadata is not mandatory if stronger content identity is proven."
  ],
  "states": [
    "DIAGNOSTIC_ACTIVE",
    "FIX_CANDIDATE",
    "FOUNDATION_QUALIFIED",
    "PHASE2_INTEGRATING",
    "RELEASE_CANDIDATE",
    "ACCEPTED"
  ],
  "transitions": [
    {
      "id": "T1_DIAGNOSTIC_CLOSE",
      "from": "DIAGNOSTIC_ACTIVE",
      "to": "FIX_CANDIDATE",
      "receipt_type": "diagnostic_close",
      "required_checks": [
        "diagnostic_artifact_identity",
        "timing_attribution_complete",
        "root_cause_proven",
        "bounded_fix_delta",
        "candidate_artifact_identity",
        "nonhardware_tests_passed"
      ],
      "human_approval_required": false
    },
    {
      "id": "T2_FOUNDATION_QUALIFY",
      "from": "FIX_CANDIDATE",
      "to": "FOUNDATION_QUALIFIED",
      "receipt_type": "foundation_qualification",
      "required_checks": [
        "install_health_passed",
        "runtime_telemetry_verified",
        "runtime_smoke_passed",
        "instrumentation_observer_effect_passed",
        "common_path_performance_audit_passed",
        "all_kernel_sweep_passed",
        "foundation_soak_passed",
        "feature_acceptance_passed",
        "clean_room_rebuild_passed",
        "golden_capsule_complete",
        "rollback_verified",
        "flight_recorder_ready"
      ],
      "human_approval_required": true
    },
    {
      "id": "T3_PHASE2_START",
      "from": "FOUNDATION_QUALIFIED",
      "to": "PHASE2_INTEGRATING",
      "receipt_type": "phase2_scope_lock",
      "required_checks": [
        "scope_contract_locked",
        "interfaces_frozen",
        "lane_plan_ready",
        "acceptance_matrix_locked"
      ],
      "human_approval_required": true
    },
    {
      "id": "T4_PHASE2_INTEGRATION",
      "from": "PHASE2_INTEGRATING",
      "to": "RELEASE_CANDIDATE",
      "receipt_type": "phase2_integration",
      "required_checks": [
        "committed_features_implemented",
        "integration_runtime_smokes_passed",
        "no_unapproved_scope_change",
        "guest_platform_integrated",
        "package_complete",
        "signed_release_preflight_passed"
      ],
      "human_approval_required": false
    },
    {
      "id": "T5_RELEASE_ACCEPT",
      "from": "RELEASE_CANDIDATE",
      "to": "ACCEPTED",
      "receipt_type": "release_acceptance",
      "required_checks": [
        "final_soak_passed",
        "physical_acceptance_passed",
        "guest_shareability_passed",
        "update_recovery_passed",
        "final_capsule_complete"
      ],
      "human_approval_required": true
    }
  ],
  "receipt_contract": {
    "schema": "hbnf-stage-receipt-v1",
    "required_top_level": [
      "schema",
      "receipt_type",
      "transition_id",
      "subject",
      "checks",
      "outcome",
      "evidence_artifacts"
    ],
    "subject_required": [
      "release_id",
      "source_identity_type",
      "source_identity",
      "artifact_sha256"
    ],
    "outcome_required": "PASS",
    "forbidden_evidence_name_patterns": [
      "receipt",
      "control_model",
      "control_state",
      "read_first",
      "postmortem",
      "runbook",
      "aks"
    ],
    "source_identity_types": [
      "git_commit",
      "source_tree_sha256",
      "source_archive_sha256"
    ]
  }
}
