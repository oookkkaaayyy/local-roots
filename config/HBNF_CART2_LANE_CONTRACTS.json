{
  "schema": "hbnf-cart2-lane-contracts-v1",
  "status": "DRAFT_UNTIL_SCOPE_LOCK",
  "interfaces": {
    "AudioFeatures": {
      "producer": "visual_audio",
      "consumers": [
        "visual_audio",
        "text_moments_optional"
      ],
      "frozen": false,
      "realtime_local_only": true,
      "candidate_contract": {
        "source_direction": "reuse_existing_WLED_AudioReactive_observables_before_new_FFT",
        "realtime_local_only": true,
        "semantic_features": [
          "energy_short",
          "energy_medium",
          "energy_slow",
          "low_pressure",
          "low_transient",
          "mid_body",
          "mid_change",
          "high_detail",
          "high_transient",
          "spectral_brightness",
          "spectral_change",
          "activity",
          "silence_confidence"
        ],
        "same_interface_for_all_vibes": true,
        "vibe_specific_mapping_required": true,
        "motion_owner_authority_preserved": true,
        "genre_recognition_forbidden": true,
        "realtime_cloud_dependency_forbidden": true,
        "independent_aux_fft_forbidden_by_default": true,
        "numeric_ranges_and_formulas": "SOURCE_AND_REPLAY_DEPENDENT__NOT_FROZEN",
        "exact_fft_geq_bin_mapping": "SOURCE_DEPENDENT__NOT_FROZEN",
        "smoothing_attack_release": "REPLAY_DEPENDENT__NOT_FROZEN",
        "performance_budget": "QUALIFIED_FOUNDATION_DEPENDENT__NOT_FROZEN"
      }
    },
    "VibeSelection": {
      "producer": "mission_control_guest",
      "consumers": [
        "visual_audio",
        "text_moments"
      ],
      "frozen": false
    },
    "VisualMoment": {
      "producer": "events_games_controller",
      "consumers": [
        "text_moments"
      ],
      "frozen": false
    },
    "GameState_GameDirective": {
      "producer": "games",
      "consumers": [
        "games",
        "mission_control_guest",
        "text_moments"
      ],
      "frozen": false
    },
    "HealthState": {
      "producer": "reliability_integration",
      "consumers": [
        "mission_control_guest"
      ],
      "frozen": false
    },
    "ControllerInput": {
      "producer": "mission_control_guest",
      "consumers": [
        "games"
      ],
      "frozen": false,
      "candidate_contract": {
        "actions": [
          "UP",
          "DOWN",
          "LEFT",
          "RIGHT",
          "PRIMARY",
          "SECONDARY",
          "PAUSE",
          "EXIT"
        ],
        "requires_controller_or_session_identity": true,
        "requires_monotonic_sequence": true,
        "stale_input_rejection_required": true,
        "browser_or_gamepad_specific_codes_forbidden_at_game_logic_boundary": true
      }
    },
    "GuestCapabilityState": {
      "producer": "mission_control_guest",
      "consumers": [
        "mission_control_guest",
        "games",
        "text_moments"
      ],
      "frozen": false,
      "candidate_contract": {
        "default_closed": true,
        "short_lived": true,
        "revocable": true,
        "capability_scoped": true,
        "no_owner_credential_in_guest_reference": true,
        "owner_only_capabilities": [
          "firmware_update",
          "recovery",
          "router_admin",
          "owner_pairing_admin",
          "advanced_audio_tuning",
          "raw_diagnostics"
        ],
        "grantable_capabilities": [
          "VIEW_STATUS",
          "SELECT_VIBE",
          "CONTROL_ARCADE",
          "JOIN_IRL_SHUFFLE",
          "JOIN_IRL_PRESSURE",
          "JOIN_IRL_SEQUENCE",
          "SEND_APPROVED_MOMENT",
          "SEND_SHORT_TEXT"
        ],
        "current_staging_aliases_are_not_frozen": true,
        "server_checks_every_mutation": true,
        "unknown_or_stale_authority_fails_closed": true
      }
    }
  },
  "lanes": {
    "visual_audio": {
      "mayChangeSharedInterfaces": false
    },
    "text_moments": {
      "mayChangeSharedInterfaces": false
    },
    "games": {
      "mayChangeSharedInterfaces": false
    },
    "mission_control_guest": {
      "mayChangeSharedInterfaces": false
    },
    "reliability_integration": {
      "mayChangeSharedInterfaces": false
    }
  },
  "rule": "Shared-interface changes require explicit integration review; lane convenience does not authorize scope reduction.",
  "execution": {
    "schema": "hbnf-cart2-lane-execution-v1",
    "core_parallel_lanes": {
      "P2_MISSION_CONTROL_SCORING": {
        "owner": "mission_control_guest",
        "activation": "FOUNDATION_SOAK_RUNNING_IF_OFFLINE_SAFE__MANDATORY_AT_PHASE2",
        "outputs": [
          "authoritative scoring/control integration",
          "owner Mission Control",
          "field-safe readback/control"
        ]
      },
      "P2_VIBE_AUDIO": {
        "owner": "visual_audio",
        "activation": "FOUNDATION_SOAK_RUNNING_IF_OFFLINE_SAFE__MANDATORY_AT_PHASE2",
        "outputs": [
          "AudioFeatures implementation",
          "distinct Vibes",
          "audio-causality acceptance"
        ]
      },
      "P2_TEXT_MOMENTS": {
        "owner": "text_moments",
        "activation": "FOUNDATION_SOAK_RUNNING_IF_OFFLINE_SAFE__MANDATORY_AT_PHASE2",
        "outputs": [
          "VisualMoment compositor",
          "premium text/moments",
          "exact return-to-base behavior"
        ]
      },
      "P2_PWA_RELIABILITY": {
        "owner": "reliability_integration",
        "activation": "FOUNDATION_SOAK_RUNNING_IF_OFFLINE_SAFE__MANDATORY_AT_PHASE2",
        "outputs": [
          "PWA freshness/cache/versioning",
          "lock-wake/reopen reliability",
          "deployment/readback reliability"
        ]
      }
    },
    "deferred_until_core_accepted": [
      "games",
      "guest_platform",
      "physical_aux_uv"
    ],
    "rule": "Core lanes are parallel by default. A ready lane may not silently wait for another ready lane."
  }
}
