{
  "schema": "hbnf-runtime-qualification-policy-v1",
  "status": "TEMPLATE_REQUIRES_QUALIFIED_BASELINE",
  "baseline_profile": null,
  "sample_interval_seconds": 5,
  "phases": {
    "integration_smoke_minutes": 5,
    "major_milestone_soak_minutes": 30,
    "foundation_promotion_soak_minutes": 90,
    "final_release_soak_minutes": 90
  },
  "comparison": {
    "require_same_or_declared_comparable_kernel_variant": true,
    "candidate_vs_baseline": {
      "fps_median_min_ratio": null,
      "frame_p95_max_ratio": null,
      "frame_p99_max_ratio": null,
      "frame_max_max_ratio": null,
      "minimum_free_heap_min_ratio": null,
      "largest_free_block_min_ratio": null,
      "aux_stale_sample_max_fraction": null
    }
  },
  "catastrophic_early_stop": {
    "enabled": true,
    "consecutive_samples": 3,
    "fps_floor_absolute": null,
    "frame_ms_p99_ceiling_absolute": null,
    "aux_projection_age_ms_ceiling": null
  },
  "qualification_requires": [
    "telemetry_contract_pass",
    "no_restart_during_run",
    "no_sustained_runtime_regression_vs_baseline",
    "no_unexplained_heap_or_fragmentation_deterioration",
    "matrix_aux_projection_health",
    "feature_regression_pass",
    "exact_release_identity_match"
  ],
  "note": "Thresholds are intentionally unset until the corrected foundation baseline is measured and explicitly frozen. The qualification tool must fail closed while required thresholds are null."
}
