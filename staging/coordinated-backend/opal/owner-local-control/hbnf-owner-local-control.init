#!/bin/sh /etc/rc.common

# Dedicated Owner gateway instance; never edits or reloads GL.iNet's Nginx.
START=85
USE_PROCD=1

CONF=/etc/hbnf-local-control/nginx.conf
NGINX=/usr/sbin/nginx

start_service() {
	[ -x "$NGINX" ] || return 1
	[ -s "$CONF" ] || return 1
	"$NGINX" -t -c "$CONF" || return 1
	procd_open_instance
	procd_set_param command "$NGINX" -c "$CONF" -g 'daemon off;'
	procd_set_param file "$CONF" /etc/hbnf-local-control/nginx-server.conf
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	[ -s "$CONF" ] || return 1
	"$NGINX" -t -c "$CONF" || return 1
	"$NGINX" -s reload -c "$CONF"
}
