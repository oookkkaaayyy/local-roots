#!/bin/sh /etc/rc.common
# HISTORICAL SOURCE PIN ONLY; NOT INSTALLED/ENABLED BY REVIEW-ONLY CAPSULE.
# Original verified init blob fb562b848ca071e6c3d0caffb0d21a5675b39db1
# START=95, single procd relay; do not spawn a second daemon.
START=95
USE_PROCD=1
start_service() {
 procd_open_instance
 procd_set_param command /usr/libexec/hbnf-matrix-relay
 procd_set_param respawn 3600 5 5
 procd_close_instance
}
