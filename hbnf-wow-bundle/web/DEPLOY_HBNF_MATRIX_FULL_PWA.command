#!/bin/bash
set -euo pipefail

EXPECTED_ZIP_SHA="90b29bc0c6a51515c552431c580b6753c0811b2503387b86faedeb18d513c017"
EXPECTED_B64_SHA="739cec5fecdb5290b4853c292f94b4700ba9c5f8ef2bff72a37c584001eca880"
TMPBASE="${TMPDIR:-/tmp}"; TMPBASE="${TMPBASE%/}"
WORK="$(mktemp -d "$TMPBASE/hbnf-wow-full-pwa.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

B64="$WORK/HBNF_MATRIX_WOW_FULL_PWA_V3_SOURCE.b64"
ZIP="$WORK/HBNF_MATRIX_WOW_FULL_PWA_V3_SOURCE.zip"

cat > "$B64" <<'__HBNF_B64__'

__HBNF_B64__

ACTUAL_B64_SHA="$(shasum -a 256 "$B64" | awk '{print $1}')"
[[ "$ACTUAL_B64_SHA" == "$EXPECTED_B64_SHA" ]] || { echo "ERROR: embedded source stream SHA mismatch."; exit 1; }

tr -d '\n' < "$B64" | base64 --decode > "$ZIP"
ACTUAL_ZIP_SHA="$(shasum -a 256 "$ZIP" | awk '{print $1}')"
[[ "$ACTUAL_ZIP_SHA" == "$EXPECTED_ZIP_SHA" ]] || { echo "ERROR: source ZIP SHA mismatch."; exit 1; }

mkdir "$WORK/unpacked"
unzip -q "$ZIP" -d "$WORK/unpacked"
SRC="$WORK/unpacked/HBNF_MATRIX_WOW_FULL_PWA_V3"
[[ -d "$SRC" ]] || { echo "ERROR: expected source folder missing."; exit 1; }

node --check "$SRC/matrix-control.js"
node "$SRC/MATRIX_UI_TEST.js" "$SRC/matrix.html" "$SRC/matrix-control.js" "$SRC/matrix-manifest.webmanifest"
chmod +x "$SRC/WEB_DEPLOY.command"

echo
echo "HBNF full-PWA source verified. Starting guarded Cloudflare static-site deployment."
echo "WEB ONLY: this does not flash, reboot, or command the physical Matrix."
exec "$SRC/WEB_DEPLOY.command"
